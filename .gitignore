# 可再生音频资产（由 generate_tts.py 重新生成，避免仓库膨胀）
# 回滚快照只需恢复源码；音频停留磁盘，git 不会删除未跟踪文件
listening_audio/
option_audio/

# public/ 下由 scripts/sync-audio.mjs 从根音频拷贝的本地服务副本(可再生, 不入库)
public/audio/
public/listening_audio/
public/option_audio/

# Agent 工作目录（.workbuddy/ 是 agent 自动生成的临时工作文件，不入库）
.workbuddy/
