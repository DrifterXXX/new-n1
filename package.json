{
  "name": "n1-study-center",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "sync:audio": "node scripts/sync-audio.mjs",
    "generate:kanji": "node scripts/generate-kanji.mjs",
    "validate:kanji-examples": "node scripts/validate-kanji-examples.mjs",
    "generate:kanji-examples": "python3 scripts/generate-kanji-examples.py",
    "build": "npm run sync:audio && vue-tsc --noEmit && vite build && node scripts/prune-woff.mjs",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-sans-jp": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@fontsource/noto-serif-jp": "^5.2.7",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^3.0.4",
    "vue": "3.5.40",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.8.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.0",
    "vitest": "^3.0.0",
    "vue-tsc": "^2.2.0"
  }
}
